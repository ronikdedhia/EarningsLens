NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Frontend (Next.js public vars) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── LLM — Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings — HuggingFace (BAAI/bge-small-en-v1.5) ─────────────────────────
HUGGINGFACE_API_TOKEN=

# ── Vector DB — Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=

# ── Structured DB — Turso ─────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://xxxx.turso.io
TURSO_AUTH_TOKEN=

# ── Notifications — Telegram ──────────────────────────────────────────────────
# Create a bot via @BotFather, add it to a channel, get chat ID via /getUpdates
TELEGRAM_ACCESS_TOKEN=
TELEGRAM_CHAT_ID=

# ── Notifications — SendGrid ──────────────────────────────────────────────────
SENDGRID_EMAIL_API_KEY=
SENDGRID_FROM_EMAIL=noreply@earningslens.app
SENDGRID_FROM_NAME=EarningsLens
NOTIFICATION_EMAIL=your@email.com

# ── Auth — Clerk ──────────────────────────────────────────────────────────────
# Create app at clerk.com → copy from API Keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
