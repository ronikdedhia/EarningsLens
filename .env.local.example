NODE_ENV=development

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Frontend (Next.js public vars) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── LLM — Groq ────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Embeddings — HuggingFace (BAAI/bge-small-en-v1.5) ─────────────────────────
HUGGINGFACE_API_TOKEN=

# ── Vector DB — Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=

# ── Structured DB — Turso ─────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://xxxx.turso.io
TURSO_AUTH_TOKEN=

# ── Notifications — Telegram ──────────────────────────────────────────────────
# Create a bot via @BotFather, add it to a channel, get chat ID via /getUpdates
TELEGRAM_ACCESS_TOKEN=
TELEGRAM_CHAT_ID=

# ── Notifications — Brevo ─────────────────────────────────────────────────────
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@earningslens.app
BREVO_FROM_NAME=EarningsLens
NOTIFICATION_EMAIL=your@email.com

# ── Auth — Clerk ──────────────────────────────────────────────────────────────
# Create app at clerk.com → copy from API Keys page
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Embeddings — Voyage AI (voyage-finance-2, 1024-dim) ──────────────────────
# Get from: voyageai.com → Dashboard → API Keys
# NOTE: when set, replaces HuggingFace. Requires Qdrant collection delete + re-ingest (384→1024 dims)
VOYAGE_API_KEY=

# ── RAG Quality — Cohere Rerank ───────────────────────────────────────────────
# Get from: cohere.com → API Keys
# Optional — if missing, reranking silently skips
COHERE_API_KEY=

# ── PDF Parsing — LlamaParse ──────────────────────────────────────────────────
# Get from: cloud.llamaindex.ai → API Keys (starts with llx-)
# Optional — if missing, falls back to pdf-parse
LLAMA_CLOUD_API_KEY=

# ── Web Scraping — Firecrawl ──────────────────────────────────────────────────
# Get from: firecrawl.dev → Dashboard → API Keys (starts with fc-)
# Optional — if missing, falls back to raw axios scraping
FIRECRAWL_API_KEY=

# ── Error Tracking — Sentry ───────────────────────────────────────────────────
# Get from: sentry.io → Project Settings → Client Keys (DSN)
# Format: https://xxxxx@oXXX.ingest.sentry.io/XXXXXXX
# Both vars should have the same value — SENTRY_DSN for backend, NEXT_PUBLIC_ for frontend
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Background Jobs — Upstash QStash ─────────────────────────────────────────
# Get from: upstash.com → QStash tab → your queue → API credentials
# Optional — if QSTASH_TOKEN missing, ingestion runs synchronously (no async queue)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public URL of your Express backend — QStash calls this to deliver jobs
# Dev: leave blank (QStash can't reach localhost — sync mode used instead)
# Prod: https://earningslens-backend.onrender.com  (or your EC2 URL)
BACKEND_PUBLIC_URL=